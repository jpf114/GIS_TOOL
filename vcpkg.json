{
  "name": "gis-tool",
  "version": "1.0.0",
  "description": "GIS toolset based on GDAL and OpenCV with plugin architecture",
  "builtin-baseline": "42f37e46d37baf7b218966434b91116bddf73461",
  "dependencies": [
    {
      "name": "gdal",
      "default-features": false,
      "features": ["expat", "geos", "jpeg", "png", "sqlite3"]
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": ["calib3d", "jpeg", "ml", "png", "stitching", "thread", "video"]
    },
    {
      "name": "proj",
      "default-features": false,
      "features": ["tiff"]
    },
    "gtest",
    {
      "name": "qtbase",
      "default-features": false,
      "features": ["sql", "widgets"]
    },
    "qtsvg"
  ],
  "overrides": []
}
